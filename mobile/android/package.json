{
  "name": "rxguard",
  "version": "1.0.0",
  "description": "RxGuard — Nigeria's Prescription Safety Platform (Android)",
  "private": true,
  "main": "index.js",
  "scripts": {
    "android":        "react-native run-android",
    "ios":            "react-native run-ios",
    "start":          "react-native start",
    "start:clean":    "react-native start --reset-cache",
    "test":           "jest",
    "test:coverage":  "jest --coverage",
    "lint":           "eslint src --ext .ts,.tsx",
    "lint:fix":       "eslint src --ext .ts,.tsx --fix",
    "type-check":     "tsc --noEmit",
    "build:android":  "cd android && ./gradlew assembleRelease",
    "build:aab":      "cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "react":                         "18.2.0",
    "react-native":                  "0.73.4",

    "@react-navigation/native":      "^6.1.10",
    "@react-navigation/native-stack":"^6.9.17",
    "@react-navigation/bottom-tabs": "^6.5.16",
    "@react-navigation/drawer":      "^6.6.14",

    "react-native-screens":           "^3.29.0",
    "react-native-safe-area-context": "^4.9.0",
    "react-native-gesture-handler":   "^2.15.0",
    "react-native-reanimated":        "^3.7.2",
    "@react-native-masked-view/masked-view": "^0.3.1",

    "@react-native-async-storage/async-storage": "^1.23.1",
    "react-native-keychain":          "^8.2.0",
    "react-native-mmkv":              "^2.12.1",

    "react-native-document-picker":   "^9.1.1",
    "react-native-image-picker":      "^7.1.0",
    "react-native-fs":                "^2.20.0",
    "react-native-blob-util":         "^0.19.8",

    "react-native-camera":            "^4.2.1",
    "react-native-permissions":       "^4.1.5",

    "axios":                          "^1.6.7",
    "axios-retry":                    "^4.1.0",

    "react-native-vector-icons":      "^10.0.3",
    "@react-native-community/netinfo":"^11.3.1",

    "react-native-toast-message":     "^2.2.0",
    "react-native-modal":             "^13.0.1",
    "react-native-progress":          "^5.0.1",
    "react-native-svg":               "^15.1.0",
    "react-native-chart-kit":         "^6.12.0",
    "react-native-linear-gradient":   "^2.8.3",

    "date-fns":                       "^3.4.0",
    "zustand":                        "^4.5.2",
    "immer":                          "^10.0.4",
    "zod":                            "^3.22.4"
  },
  "devDependencies": {
    "@babel/core":                     "^7.23.9",
    "@babel/preset-env":               "^7.23.9",
    "@babel/runtime":                  "^7.23.9",
    "@react-native/babel-preset":      "0.73.21",
    "@react-native/eslint-config":     "0.73.2",
    "@react-native/metro-config":      "0.73.5",
    "@react-native/typescript-config": "0.73.1",
    "@types/react":                    "^18.2.57",
    "@types/react-native":             "^0.73.0",
    "@types/react-native-vector-icons":"^6.4.18",
    "typescript":                      "5.3.3",
    "eslint":                          "^8.57.0",
    "prettier":                        "^3.2.5",
    "@testing-library/react-native":   "^12.4.3",
    "@testing-library/jest-native":    "^5.4.3",
    "react-test-renderer":              "18.2.0",
    "jest":                            "^29.7.0",
    "babel-jest":                      "^29.7.0",
    "metro-react-native-babel-preset": "^0.77.0"
  },
  "jest": {
    "preset": "react-native",
    "setupFilesAfterEnv": ["@testing-library/jest-native/extend-expect"],
    "transformIgnorePatterns": [
      "node_modules/(?!(react-native|@react-native|@react-navigation|react-native-vector-icons|react-native-toast-message|react-native-progress|react-native-svg|react-native-chart-kit|react-native-linear-gradient|react-native-modal)/)"
    ],
    "moduleFileExtensions": ["ts", "tsx", "js", "jsx", "json"],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts",
      "!src/**/__tests__/**"
    ]
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 100,
    "tabWidth": 2
  },
  "eslintConfig": {
    "root": true,
    "extends": "@react-native",
    "rules": {
      "react-native/no-inline-styles": "warn",
      "no-console": ["warn", { "allow": ["warn", "error"] }]
    }
  }
}