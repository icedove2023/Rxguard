APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --------------------------------------------------------------
# Supabase (managed PostgreSQL) — recommended
# Values come from your Supabase project's Settings -> Database page.
# --------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=db.YOUR-PROJECT-REF.supabase.co
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=
DB_SCHEMA=public
DB_SSLMODE=require
DB_EMULATE_PREPARES=true

# --------------------------------------------------------------
# Alternatives (uncomment one block instead, and comment out pgsql above)
# --------------------------------------------------------------
# DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Keep local development files on the private local disk. Set this to `b2`
# in Render so prescription uploads survive container restarts/deploys.
PRESCRIPTION_STORAGE_DISK=private
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-005
AWS_BUCKET=rxguard-prescriptions
AWS_ENDPOINT=https://s3.us-east-005.backblazeb2.com
AWS_USE_PATH_STYLE_ENDPOINT=false

# --------------------------------------------------------------
# Supabase Auth — email verification, password reset/change, OTP
# --------------------------------------------------------------
# In the Supabase Dashboard: Project Settings -> Auth -> SMTP Settings,
# enable custom SMTP pointed at Resend so confirmation/recovery emails
# actually get delivered. jwt_secret is under Project Settings -> API.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_AUTH_REDIRECT_URL=http://localhost/pages/auth-callback.html
# Deep link back into the mobile app (see mobile/android/android/README.md)
SUPABASE_MOBILE_REDIRECT_URL=rxguard://auth-callback

# --------------------------------------------------------------
# External APIs
# --------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT=15

OPENFDA_API_KEY=
OPENFDA_BASE_URL=https://api.fda.gov
OPENFDA_TIMEOUT=15

EMDEX_API_KEY=
EMDEX_BASE_URL=https://api.emdex.ng/v1

VITE_APP_NAME="${APP_NAME}"

# --------------------------------------------------------------
# Tesseract OCR (free, open-source, CLI-based — step 1 of the
# prescription pipeline). Requires tesseract-ocr installed on the host
# (e.g. `apt install tesseract-ocr tesseract-ocr-eng` or see Dockerfile).
# --------------------------------------------------------------
TESSERACT_BINARY=tesseract
TESSERACT_LANGUAGE=eng
TESSERACT_TIMEOUT=60
